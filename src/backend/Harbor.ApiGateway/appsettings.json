{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "protectedRoute": {
        "ClusterId": "authCluster",
        "Match": {
          "Path": "/api/protected/{**catch-all}"
        }
      },
      "deploymentRoute": {
        "ClusterId": "deploymentCluster",
        "Match": {
          "Path": "/api/deployment/{**catch-all}"
        }
      },
      "projectRoute": {
        "ClusterId": "projectCluster",
        "Match": {
          "Path": "/api/project/{**catch-all}"
        }
      },
      "environmentRoute": {
        "ClusterId": "environmentCluster",
        "Match": {
          "Path": "/api/environment/{**catch-all}"
        }
      },
      "reportingRoute": {
        "ClusterId": "reportingCluster",
        "Match": {
          "Path": "/api/reporting/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5196"
          }
        }
      },
      "deploymentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5288"
          }
        }
      },
      "projectCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5079"
          }
        }
      },
      "environmentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5292"
          }
        }
      },
      "reportingCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://localhost:5243"
          }
        }
      }
    }
  }
}
