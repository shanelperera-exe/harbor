# Harbor Frontend Configuration
# Variables prefixed with VITE_ are exposed to your React code.

# The base URL of the API Gateway
VITE_API_BASE_URL=http://localhost:5000/api

# The GitHub App slug (App settings -> App slug) whose installation the UI offers.
# It must be the same app the backend holds GITHUB_APP_ID / GITHUB_APP_PRIVATE_KEY_BASE64
# for, otherwise GitHub installs a different app and Harbor never sees the installation.
VITE_GITHUB_APP_SLUG=harbor-platform

# Any other frontend specific public keys or toggles
VITE_ENABLE_ANALYTICS=false
