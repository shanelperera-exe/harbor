{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "authCluster",
        "CorsPolicy": "AllowFrontendOrigins",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "protectedRoute": {
        "ClusterId": "authCluster",
        "CorsPolicy": "AllowFrontendOrigins",
        "Match": {
          "Path": "/api/protected/{**catch-all}"
        }
      },
      "deploymentWebhookRoute": {
        "ClusterId": "deploymentCluster",
        "Order": 0,
        "Match": {
          "Path": "/api/deployments/webhooks/{**catch-all}"
        }
      },
      "deploymentRoute": {
        "ClusterId": "deploymentCluster",
        "CorsPolicy": "AllowFrontendOrigins",
        "Match": {
          "Path": "/api/deployments/{**catch-all}"
        }
      },
      "environmentRoute": {
        "ClusterId": "environmentCluster",
        "Order": 1,
        "CorsPolicy": "AllowFrontendOrigins",
        "Match": {
          "Path": "/api/projects/{projectId}/environments/{**catch-all}"
        }
      },
      "projectRoute": {
        "ClusterId": "projectCluster",
        "Order": 2,
        "CorsPolicy": "AllowFrontendOrigins",
        "Match": {
          "Path": "/api/projects/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/api/projects/{**catch-all}" }
        ]
      },
      "reportingWebhooksRoute": {
        "ClusterId": "reportingCluster",
        "Order": 0,
        "Match": {
          "Path": "/api/webhooks/{**catch-all}"
        }
      },
      "reportingRoute": {
        "ClusterId": "reportingCluster",
        "CorsPolicy": "AllowFrontendOrigins",
        "Match": {
          "Path": "/api/reporting/{**catch-all}"
        }
      },
      "reportsRoute": {
        "ClusterId": "reportingCluster",
        "CorsPolicy": "AllowFrontendOrigins",
        "Match": {
          "Path": "/api/reports/{**catch-all}"
        }
      },
      "signalrLogsRoute": {
        "ClusterId": "reportingCluster",
        "CorsPolicy": "AllowFrontendOrigins",
        "Match": {
          "Path": "/hubs/logs/{**catch-all}"
        }
      },
      "notificationRoute": {
        "ClusterId": "deploymentCluster",
        "CorsPolicy": "AllowFrontendOrigins",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "swaggerAuthRoute": {
        "ClusterId": "authCluster",
        "Order": 0,
        "Match": {
          "Path": "/swagger-docs/auth/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "swaggerProjectRoute": {
        "ClusterId": "projectCluster",
        "Order": 0,
        "Match": {
          "Path": "/swagger-docs/project/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "swaggerEnvironmentRoute": {
        "ClusterId": "environmentCluster",
        "Order": 0,
        "Match": {
          "Path": "/swagger-docs/environment/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "swaggerDeploymentRoute": {
        "ClusterId": "deploymentCluster",
        "Order": 0,
        "Match": {
          "Path": "/swagger-docs/deployment/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      },
      "swaggerReportingRoute": {
        "ClusterId": "reportingCluster",
        "Order": 0,
        "Match": {
          "Path": "/swagger-docs/reporting/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "/swagger/{**catch-all}" }
        ]
      }
    },
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://authentication-service:8080"
          }
        }
      },
      "deploymentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://deployment-service:8080"
          }
        }
      },
      "projectCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://project-service:8080"
          }
        }
      },
      "environmentCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://environment-service:8080"
          }
        }
      },
      "reportingCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://reporting-service:8080"
          }
        }
      }
    }
  }
}
