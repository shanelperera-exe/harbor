# Harbor Frontend Configuration
# Variables prefixed with VITE_ are exposed to your React code.

# The base URL of the API Gateway
VITE_API_BASE_URL=http://localhost:5000/api

# Any other frontend specific public keys or toggles
VITE_ENABLE_ANALYTICS=false

# Observability tools linked from the admin "Observability" page (https only outside localhost).
# Leave unset in dev to use docker-compose defaults (localhost:3000 / localhost:9090).
VITE_GRAFANA_URL=http://localhost:3000
VITE_PROMETHEUS_URL=http://localhost:9090
