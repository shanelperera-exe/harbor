{
  "stryker-config": {
    "project": "Harbor.Deployment.csproj",
    "test-projects": [
      "tests/unit/Harbor.Deployment.Tests/Harbor.Deployment.Tests.csproj"
    ],
    "reporters": [
      "Progress",
      "Html",
      "ClearText",
      "Json",
      "Markdown"
    ],
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 60
    },
    "mutate": [
      "**/DeploymentUrlExtractor.cs",
      "**/DeploymentLogSanitizer.cs"
    ],
    "concurrency": 4,
    "log-level": "info"
  }
}
