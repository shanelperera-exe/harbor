# Harbor Backend & Infrastructure Configuration
# This file serves as a template. Do NOT commit the real .env file.

# Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=harbor_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_signing_key_here
JWT_ISSUER=harbor-auth
JWT_AUDIENCE=harbor-web
JWT_EXPIRY_MINUTES=480

# External login OAuth / GitHub App credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FRONTEND_URL=http://localhost:5173

# GitHub App credentials (replaces GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET for login)
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_PRIVATE_KEY_BASE64=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DEPLOYMENT_TOPIC=deployment-events

# GitHub Actions Integration
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here
GITHUB_ACTIONS_WORKFLOW=deploy.yml
GITHUB_API_BASE_URL=https://api.github.com/

# Application URLs
API_GATEWAY_URL=http://localhost:5000
AUTH_SERVICE_URL=http://localhost:5000
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:8081

# Email (SMTP/Brevo)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USERNAME=your_brevo_email@example.com
SMTP_PASSWORD=your_brevo_smtp_key
SMTP_FROM_NAME=Harbor Team
SMTP_FROM_EMAIL=your_verified_brevo_email@example.com

# Admin credentials (for first-run seeding)
# ADMIN_EMAIL=admin@harbor.local
# ADMIN_PASSWORD=Admin123!

# Environment Secret Protection (AES-256-GCM)
# Must be a base64-encoded 32-byte key used to encrypt/decrypt environment secure values.
# Never commit the real key. Generate with: dotnet script -e "System.Convert.ToBase64String(System.Security.Cryptography.RandomNumberGenerator.GetBytes(32))"
ENVIRONMENT_SECRETS_KEY=

# Ngrok (local development tunnel only - not used in production)
# Get your token from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
