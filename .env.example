# Harbor Backend & Infrastructure Configuration
# This file serves as a template. Do NOT commit the real .env file.

# Database Configuration
MYSQL_SERVER=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=harbor_db
MYSQL_USER=root
MYSQL_PASSWORD=your_secure_password

# Authentication (JWT)
JWT_SECRET=your_super_secret_jwt_signing_key_here
JWT_ISSUER=harbor-auth
JWT_AUDIENCE=harbor-web

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_DEPLOYMENT_TOPIC=deployment-events

# GitHub Actions Integration
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# Application URLs
API_GATEWAY_URL=http://localhost:5000
